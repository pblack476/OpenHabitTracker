@page "/today"
@using OpenHabitTracker.App
@using OpenHabitTracker.Data.Models
@using OpenHabitTracker.Query
@using OpenHabitTracker.Services
@inject ClientState ClientState
@inject ITaskService TaskService
@inject IHabitService HabitService
@inject IStringLocalizer Loc

<PageTitle>OpenHabitTracker - @Loc["Today"]</PageTitle>

<div class="col child-column app-today">
    <span class="app-dashboard-label"><i class="bi bi-calendar-check" aria-hidden="true"></i> @DateTime.Today.ToShortDateString()</span>
    <h1>@Loc["Today"]</h1>
    <div class="app-today-grid">
        <section class="app-today-panel" aria-label="@Loc["Overdue tasks"]">
            <h2 class="text-danger-emphasis"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> @Loc["Overdue tasks"] (@OverdueTasks.Count)</h2>
            <div class="app-today-list">
                @foreach (TaskModel task in OverdueTasks)
                {
                    <div class="app-today-entry" @key="task.Id">
                        <a href="@($"/tasks/{task.Id}")">@task.Title</a>
                        <span class="app-today-meta">@task.PlannedAt?.ToString("g")</span>
                        <button class="btn btn-sm btn-outline-primary" aria-label="@Loc["Mark as done"]" @onclick="() => CompleteTask(task)"><i class="bi bi-check2" aria-hidden="true"></i></button>
                    </div>
                }
            </div>
        </section>
        <section class="app-today-panel" aria-label="@Loc["Today"]">
            <h2><i class="bi bi-clock" aria-hidden="true"></i> @Loc["Today"] (@TodayTasks.Count)</h2>
            <div class="app-today-list">
                @foreach (TaskModel task in TodayTasks)
                {
                    <div class="app-today-entry" @key="task.Id">
                        <a href="@($"/tasks/{task.Id}")">@task.Title</a>
                        <span class="app-today-meta">@(task.PlannedTime is null ? task.PlannedAt?.ToShortDateString() : task.PlannedAt?.ToShortTimeString())</span>
                        <button class="btn btn-sm btn-outline-primary" aria-label="@Loc["Mark as done"]" @onclick="() => CompleteTask(task)"><i class="bi bi-check2" aria-hidden="true"></i></button>
                    </div>
                }
            </div>
        </section>
        <section class="app-today-panel" aria-label="@Loc["Next 3 days"]">
            <h2><i class="bi bi-calendar3" aria-hidden="true"></i> @Loc["Next 3 days"] (@UpcomingTasks.Count)</h2>
            <div class="app-today-list">
                @foreach (TaskModel task in UpcomingTasks)
                {
                    <div class="app-today-entry" @key="task.Id">
                        <a href="@($"/tasks/{task.Id}")">@task.Title</a>
                        <span class="app-today-meta">@task.PlannedAt?.ToShortDateString()</span>
                        <button class="btn btn-sm btn-outline-primary" aria-label="@Loc["Mark as done"]" @onclick="() => CompleteTask(task)"><i class="bi bi-check2" aria-hidden="true"></i></button>
                    </div>
                }
            </div>
        </section>
        <section class="app-today-panel" aria-label="@Loc["Recurring tasks"]">
            <h2><i class="bi bi-repeat" aria-hidden="true"></i> @Loc["Recurring tasks"] (@RecurringTasks.Count)</h2>
            <div class="app-today-list">
                @foreach (HabitModel habit in RecurringTasks)
                {
                    <div class="app-today-entry" @key="habit.Id">
                        <a href="@($"/habits/{habit.Id}")">@habit.Title</a>
                        <span class="app-today-meta">@habit.GetRatio(ClientState.Settings.SelectedRatio).ToString("N0")%</span>
                        <button class="btn btn-sm btn-outline-primary" aria-label="@Loc["Mark as done"]" @onclick="() => CompleteRecurring(habit)"><i class="bi bi-check2" aria-hidden="true"></i></button>
                    </div>
                }
            </div>
        </section>
    </div>
</div>

@code {
    private List<TaskModel> OverdueTasks => TodayAgenda.Overdue(TaskService.Tasks ?? [], DateTime.Now).ToList();
    private List<TaskModel> TodayTasks => TodayAgenda.Today(TaskService.Tasks ?? [], DateTime.Now).ToList();
    private List<TaskModel> UpcomingTasks => TodayAgenda.Upcoming(TaskService.Tasks ?? [], DateTime.Now).ToList();
    private List<HabitModel> RecurringTasks => TodayAgenda.RecurringDue(HabitService.Habits ?? [], ClientState.Settings.SelectedRatio).ToList();

    protected override async Task OnInitializedAsync()
    {
        await TaskService.Initialize();
        await HabitService.Initialize();
        await HabitService.LoadAllTimesDone();
    }

    private async Task CompleteTask(TaskModel task)
    {
        await TaskService.MarkAsDone(task);
    }

    private async Task CompleteRecurring(HabitModel habit)
    {
        await HabitService.LoadTimesDone(habit);
        await HabitService.MarkAsDone(habit);
    }
}
