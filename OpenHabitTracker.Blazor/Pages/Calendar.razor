@page "/calendar"
@using OpenHabitTracker.App
@using OpenHabitTracker.Data
@using OpenHabitTracker.Data.Models
@using OpenHabitTracker.Query
@using OpenHabitTracker.Services
@inject ClientState ClientState
@inject ITaskService TaskService
@inject IHabitService HabitService
@inject IServiceProvider Services
@inject IStringLocalizer Loc

<PageTitle>OpenHabitTracker - @Loc["Calendar"]</PageTitle>

<div class="col child-column app-planner">
    <header class="app-planner-header">
        <h1><i class="bi bi-calendar3 me-2" aria-hidden="true"></i>@Loc["Calendar"]</h1>
        <div class="d-flex gap-1 flex-wrap">
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => Move(-1)" aria-label="@Loc["Previous"]"><i class="bi bi-chevron-left" aria-hidden="true"></i></button>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => _selected = DateTime.Today">@Loc["Today"]</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => Move(1)" aria-label="@Loc["Next"]"><i class="bi bi-chevron-right" aria-hidden="true"></i></button>
            <button type="button" class="@($"btn btn-sm {(_mode == ViewMode.Month ? "btn-primary" : "btn-outline-secondary")}")" @onclick="() => _mode = ViewMode.Month">@Loc["Month"]</button>
            <button type="button" class="@($"btn btn-sm {(_mode == ViewMode.Week ? "btn-primary" : "btn-outline-secondary")}")" @onclick="() => _mode = ViewMode.Week">@Loc["Week"]</button>
            <button type="button" class="@($"btn btn-sm {(_mode == ViewMode.Day ? "btn-primary" : "btn-outline-secondary")}")" @onclick="() => _mode = ViewMode.Day">@Loc["Day"]</button>
        </div>
    </header>
    <h2 class="h5 mb-3">@_selected.ToString("MMMM yyyy")</h2>

    @if (_mode != ViewMode.Day)
    {
        <div class="app-calendar-weekdays" aria-hidden="true">
            @foreach (DateTime day in PlannerCalendar.WeekGrid(_selected, ClientState.Settings.FirstDayOfWeek))
            {
                <span>@day.ToString("ddd")</span>
            }
        </div>

        <div class="app-calendar-grid" role="group" aria-label="@Loc["Calendar"]">
            @foreach (DateTime day in VisibleDates)
            {
                IReadOnlyList<TaskModel> scheduled = GetTasksForDay(day);
                IReadOnlyList<HabitModel> recurring = GetRecurringForDay(day);
                int count = scheduled.Count + recurring.Count;
                int hidden = Math.Max(0, count - 3);
                <button @key="day" class="app-calendar-day" type="button"
                        data-selected="@(day.Date == _selected.Date)" data-today="@(day.Date == DateTime.Today)"
                        data-in-month="@(day.Month == _selected.Month)"
                        aria-label="@($"{day:D} — {count} {Loc["Tasks and habits"]}")"
                        aria-pressed="@(day.Date == _selected.Date)" @onclick="() => SelectDate(day)">
                    <span class="app-calendar-date">@day.Day</span>
                    @if (count > 0)
                    {
                        <span class="app-calendar-count">@count</span>
                        @foreach (TaskModel task in scheduled.Take(3))
                        {
                            <span class="@($"app-calendar-preview {(task.CompletedAt is null ? "" : "app-calendar-preview-done")}")" title="@task.Title"><i class="bi bi-list-task" aria-hidden="true"></i> @task.Title</span>
                        }
                        @foreach (HabitModel habit in recurring.Take(Math.Max(0, 3 - scheduled.Count)))
                        {
                            <span class="app-calendar-preview app-calendar-preview-recurring" title="@habit.Title"><i class="bi bi-repeat" aria-hidden="true"></i> @habit.Title</span>
                        }
                        @if (hidden > 0)
                        {
                            <span class="app-calendar-more">+@hidden</span>
                        }
                    }
                </button>
            }
        </div>
    }

    <section class="app-today-panel" aria-label="@_selected.ToString("D")">
        <h2>@_selected.ToString("D") — @(GetTasksForDay(_selected).Count + GetRecurringForDay(_selected).Count) @Loc["Tasks and habits"]</h2>

        <div class="app-calendar-agenda">
            @foreach (TaskModel task in GetTasksForDay(_selected))
            {
                <div class="app-today-entry" @key="@($"task-{task.Id}")">
                    <a href="@($"/tasks/{task.Id}")"><i class="bi bi-list-task" aria-hidden="true"></i> @task.Title</a>
                    @if (task.CompletedAt is not null)
                    {
                        <span class="app-today-meta"><i class="bi bi-check-circle" aria-hidden="true"></i> @Loc["Completed"]</span>
                    }
                    else
                    {
                        <span class="app-today-meta">@(task.PlannedTime is null ? Loc["Planned"].Value : task.PlannedAt?.ToShortTimeString())</span>
                        <button class="btn btn-sm btn-outline-primary" aria-label="@Loc["Mark as done"]" @onclick="() => TaskService.MarkAsDone(task)"><i class="bi bi-check2" aria-hidden="true"></i></button>
                    }
                </div>
            }

            @foreach (HabitModel habit in GetRecurringForDay(_selected))
            {
                CalendarRecurrenceRule? rule = Workspace?.GetCalendarRule(habit.Id);
                bool completed = CalendarRecurrence.IsCompletedOn(_selected, habit.TimesDone);
                <div class="app-today-entry" @key="@($"recurring-{habit.Id}")">
                    <a href="@($"/habits/{habit.Id}")"><i class="bi bi-repeat" aria-hidden="true"></i> @habit.Title</a>
                    @if (completed)
                    {
                        <span class="app-today-meta"><i class="bi bi-check-circle" aria-hidden="true"></i> @Loc["Completed"]</span>
                    }
                    else
                    {
                        @if (rule is null)
                        {
                            <span class="app-calendar-forecast" title="@Loc["Estimated from repeat interval"]">@Loc["Estimated from repeat interval"]</span>
                        }
                        @if (rule is not null && _selected.Date >= DateTime.Today)
                        {
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => SkipOccurrence(habit, _selected)">@Loc["Skip occurrence"]</button>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => PostponeOccurrence(habit, _selected)">@Loc["Postpone"]</button>
                        }
                        @if (_selected.Date == DateTime.Today)
                        {
                            <button class="btn btn-sm btn-outline-primary" aria-label="@Loc["Mark as done"]" @onclick="() => CompleteRecurring(habit)"><i class="bi bi-check2" aria-hidden="true"></i></button>
                        }
                    }
                </div>
            }

            @if (GetTasksForDay(_selected).Count == 0 && GetRecurringForDay(_selected).Count == 0)
            {
                <p class="text-body-secondary m-0">@Loc["No tasks planned"]</p>
            }
        </div>
    </section>

    <section class="app-today-panel mt-3" aria-label="@Loc["Unscheduled tasks"]">
        <h2><i class="bi bi-inbox" aria-hidden="true"></i> @Loc["Unscheduled tasks"] (@Unscheduled.Count)</h2>
        <p class="text-body-secondary small">@Loc["Unscheduled calendar explanation"]</p>
        <div class="app-calendar-agenda app-calendar-unscheduled">
            @foreach (TaskModel task in Unscheduled)
            {
                <div class="app-today-entry" @key="@($"unscheduled-{task.Id}")">
                    <a href="@($"/tasks/{task.Id}")"><i class="bi bi-list-task" aria-hidden="true"></i> @task.Title</a>
                    <button class="btn btn-sm btn-outline-primary" @onclick="() => ScheduleTask(task)" title="@_selected.ToString("d")">
                        <i class="bi bi-calendar-plus" aria-hidden="true"></i> @Loc["Schedule for selected day"]
                    </button>
                </div>
            }
        </div>
    </section>
</div>

@code {
    private enum ViewMode { Day, Week, Month }

    private ViewMode _mode = ViewMode.Month;
    private DateTime _selected = DateTime.Today;
    private PersonalWorkspaceState? Workspace => Services.GetService(typeof(PersonalWorkspaceState)) as PersonalWorkspaceState;

    private IReadOnlyList<DateTime> VisibleDates => _mode == ViewMode.Month
        ? PlannerCalendar.MonthGrid(_selected, ClientState.Settings.FirstDayOfWeek)
        : PlannerCalendar.WeekGrid(_selected, ClientState.Settings.FirstDayOfWeek);

    private IReadOnlyList<TaskModel> GetTasksForDay(DateTime day)
        => PlannerCalendar.TasksForDay(TaskService.Tasks ?? [], day);

    private IReadOnlyList<HabitModel> GetRecurringForDay(DateTime day)
        => PlannerCalendar.RecurringForDay(HabitService.Habits ?? [], day,
            id => Workspace?.GetCalendarRule(id));

    private IReadOnlyList<TaskModel> Unscheduled
        => PlannerCalendar.Unscheduled(TaskService.Tasks ?? []);

    protected override async Task OnInitializedAsync()
    {
        await TaskService.Initialize();
        await HabitService.Initialize();
        await HabitService.LoadAllTimesDone();
        if (Workspace is PersonalWorkspaceState workspace)
            await workspace.Load();
    }

    private async Task ScheduleTask(TaskModel task)
        => await TaskService.Reschedule(task, _selected.Date);

    private async Task SkipOccurrence(HabitModel habit, DateTime day)
    {
        if (Workspace is PersonalWorkspaceState workspace)
            await workspace.SkipOccurrence(habit.Id, day);
    }

    private async Task PostponeOccurrence(HabitModel habit, DateTime day)
    {
        if (Workspace is PersonalWorkspaceState workspace)
            await workspace.PostponeOccurrence(habit.Id, day, day.AddDays(1));
    }

    private async Task CompleteRecurring(HabitModel habit)
    {
        await HabitService.LoadTimesDone(habit);
        await HabitService.MarkAsDone(habit);
    }

    private void SelectDate(DateTime date) => _selected = date.Date;

    private void Move(int direction)
    {
        _selected = _mode switch
        {
            ViewMode.Month => _selected.AddMonths(direction),
            ViewMode.Week => _selected.AddDays(7 * direction),
            _ => _selected.AddDays(direction)
        };
    }
}
