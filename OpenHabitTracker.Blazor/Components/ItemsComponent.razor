@using OpenHabitTracker.Data.Models
@using OpenHabitTracker.Services

@inject IItemService ItemService
@inject ISearchFilterService SearchFilterService
@inject IStringLocalizer Loc

<div class="@Items.Color">
    @if (Items?.Items is not null)
    {
        foreach (ItemModel item in Items.Items)
        {
            <div class="input-group flex-nowrap">
                @if (IsReadOnly)
                {
                    <div class="input-group-text bg-transparent">
                        <InputCheckbox id="@($"item-{item.Id}")" class="form-check-input mt-0" Value="item.IsDone" ValueExpression="() => item.IsDone" ValueChanged="(bool done) => ItemService.SetIsDone(item, done)" />
                    </div>
                    <label for="@($"item-{item.Id}")" class="input-group-text bg-transparent flex-grow-1 text-wrap highlightable">@((MarkupString)SearchFilterService.MarkSearchResults(item.Title))</label>
                }
                else
                {
                    <div class="input-group-text bg-transparent">
                        <InputCheckbox aria-label="@item.Title" class="form-check-input mt-0" Value="item.IsDone" ValueExpression="() => item.IsDone" ValueChanged="(bool done) => ItemService.SetIsDone(item, done)" />
                    </div>
                    if (item == ItemService.SelectedItem)
                    {
                        <InputText class="form-control bg-transparent" @ref="inputElement" aria-label="@Loc["Edit item"]" Value="@item.Title" ValueExpression="() => item.Title" ValueChanged="ItemService.UpdateItem" @onfocusout="(args) => ItemService.SelectedItem = null" />
                    }
                    else
                    {
                        <button class="input-group-text bg-transparent flex-grow-1 text-wrap highlightable" @onclick="() => { ItemService.SelectedItem = item; shouldFocus = true; }">@((MarkupString)SearchFilterService.MarkSearchResults(item.Title))</button>
                    }
                    <button class="btn btn-outline-primary" aria-label="@Loc["Delete"]" @onclick="() => ItemService.DeleteItem(Items, item)"><i class="bi bi-trash"></i></button>
                }
            </div>
        }
    }

    @if (!IsReadOnly && ItemService.NewItem is not null)
    {
        <form @onsubmit=AddNewItem>
            <div class="input-group">
                <InputTextImmediate class="form-control bg-transparent" @bind-Value="ItemService.NewItem.Title" placeholder="@Loc["Add new item"]" aria-label="@Loc["Add new item"]" aria-required="true" />

                <button class="btn btn-outline-primary" aria-label="@Loc["Add"]" disabled="@string.IsNullOrWhiteSpace(ItemService.NewItem.Title)"><i class="bi bi-plus-square"></i></button>
            </div>
        </form>
    }

    @if (!IsReadOnly)
    {
        <button type="button" class="btn btn-sm btn-outline-secondary mt-1" @onclick="() => _bulkOpen = !_bulkOpen"><i class="bi bi-list-ol" aria-hidden="true"></i> @Loc["Paste multiple"]</button>
        @if (_bulkOpen)
        {
            <div class="app-bulk-paste mt-1">
                <label for="checklist-bulk-@Items.Id" class="form-label">@Loc["One item per line"]</label>
                <textarea id="checklist-bulk-@Items.Id" class="form-control" rows="4" @bind="_bulkText" placeholder="@Loc["One item per line"]"></textarea>
                @if (_bulkError is not null) { <p role="alert" class="text-danger small">@_bulkError</p> }
                <button class="btn btn-sm btn-primary mt-2" disabled="@string.IsNullOrWhiteSpace(_bulkText)" @onclick="AddMultipleItems">@Loc["Add"]</button>
            </div>
        }
    }
</div>

@code {
    [EditorRequired]
    [Parameter]
    public ItemsModel Items { get; set; } = null!;

    [Parameter]
    public bool IsReadOnly { get; set; }

    InputText? inputElement;

    bool shouldFocus;
    bool _bulkOpen;
    string _bulkText = string.Empty;
    string? _bulkError;

    async Task AddMultipleItems()
    {
        try
        {
            int created = await ItemService.AddItemsFromLines(Items, _bulkText);
            if (created > 0)
            {
                _bulkOpen = false;
                _bulkText = string.Empty;
                _bulkError = null;
            }
        }
        catch (ArgumentException exception)
        {
            _bulkError = exception.Message;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        await ItemService.Initialize(Items);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (shouldFocus && inputElement?.Element is not null)
        {
            shouldFocus = false;
            await inputElement.Element.Value.FocusAsync();
        }
    }

    async Task AddNewItem()
    {
        if (ItemService.NewItem is not null && !string.IsNullOrWhiteSpace(ItemService.NewItem.Title))
        {
            await ItemService.AddItem(Items);
        }
    }
}
