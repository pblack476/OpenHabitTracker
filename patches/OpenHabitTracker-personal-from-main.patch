diff --git a/OpenHabitTracker/Query/UrgencyOrder.cs b/OpenHabitTracker/Query/UrgencyOrder.cs
new file mode 100644
--- /dev/null
+++ b/OpenHabitTracker/Query/UrgencyOrder.cs
@@ -0,0 +1,43 @@
+using OpenHabitTracker.Data;
+using OpenHabitTracker.Data.Models;
+
+namespace OpenHabitTracker.Query;
+
+/// <summary>
+/// Tasks: overdue, today, within three days, later, unscheduled, completed.
+/// Higher priority breaks ties within each urgency bucket.
+/// Recurring tasks: most overdue relative to their expected interval first.
+/// </summary>
+public static class UrgencyOrder
+{
+    public enum TaskBucket { Overdue, Today, Soon, Later, Unscheduled, Completed }
+
+    public static TaskBucket GetTaskBucket(TaskModel task, DateTime now)
+    {
+        if (task.CompletedAt is not null)
+            return TaskBucket.Completed;
+
+        if (task.PlannedAt is not DateTime date)
+            return TaskBucket.Unscheduled;
+
+        // Today's date-only tasks have a 23:59:59 sentinel, so they stay due today.
+        if (date < now && (!task.IsPlannedDateOnly || date.Date < now.Date))
+            return TaskBucket.Overdue;
+
+        int days = (date.Date - now.Date).Days;
+        return days <= 0 ? TaskBucket.Today : days <= 3 ? TaskBucket.Soon : TaskBucket.Later;
+    }
+
+    public static IEnumerable<TaskModel> OrderTasks(IEnumerable<TaskModel> tasks, DateTime now)
+        => tasks.OrderBy(task => GetTaskBucket(task, now))
+            .ThenByDescending(task => task.Priority)
+            .ThenBy(task => task.PlannedAt ?? DateTime.MaxValue)
+            .ThenBy(task => task.Title, StringComparer.CurrentCultureIgnoreCase);
+
+    public static IEnumerable<HabitModel> OrderHabits(IEnumerable<HabitModel> habits, Ratio ratio)
+        => habits.OrderByDescending(habit => SafeRatio(habit.GetRatio(ratio)))
+            .ThenByDescending(habit => habit.Priority)
+            .ThenBy(habit => habit.Title, StringComparer.CurrentCultureIgnoreCase);
+
+    private static double SafeRatio(double value) => double.IsFinite(value) ? value : 0;
+}
diff --git a/OpenHabitTracker/Services/ContentClipboard.cs b/OpenHabitTracker/Services/ContentClipboard.cs
new file mode 100644
--- /dev/null
+++ b/OpenHabitTracker/Services/ContentClipboard.cs
@@ -0,0 +1,84 @@
+using OpenHabitTracker.Data;
+using OpenHabitTracker.Data.Models;
+
+namespace OpenHabitTracker.Services;
+
+/// <summary>
+/// An in-app clipboard for duplicating content. Copies are detached snapshots and
+/// can only be pasted into the same account and data location that copied them.
+/// It never stores existing entity IDs, completions, or history in the new model.
+/// </summary>
+public sealed class ContentClipboard
+{
+    private sealed record Entry<T>(T Model, long UserId, DataLocation Location);
+
+    private Entry<TaskModel>? _task;
+    private Entry<NoteModel>? _note;
+    private Entry<HabitModel>? _habit;
+
+    public bool CanPasteTask(long userId, DataLocation location) => Matches(_task, userId, location);
+    public bool CanPasteNote(long userId, DataLocation location) => Matches(_note, userId, location);
+    public bool CanPasteHabit(long userId, DataLocation location) => Matches(_habit, userId, location);
+
+    private static bool Matches<T>(Entry<T>? entry, long userId, DataLocation location)
+        => entry is not null && entry.UserId == userId && entry.Location == location;
+
+    public void CopyTask(TaskModel source, long userId, DataLocation location)
+        => _task = new(CloneTask(source), userId, location);
+
+    public void CopyNote(NoteModel source, long userId, DataLocation location)
+        => _note = new(CloneNote(source), userId, location);
+
+    public void CopyHabit(HabitModel source, long userId, DataLocation location)
+        => _habit = new(CloneHabit(source), userId, location);
+
+    public TaskModel? PasteTask(long userId, DataLocation location)
+        => CanPasteTask(userId, location) ? CloneTask(_task!.Model) : null;
+
+    public NoteModel? PasteNote(long userId, DataLocation location)
+        => CanPasteNote(userId, location) ? CloneNote(_note!.Model) : null;
+
+    public HabitModel? PasteHabit(long userId, DataLocation location)
+        => CanPasteHabit(userId, location) ? CloneHabit(_habit!.Model) : null;
+
+    private static TaskModel CloneTask(TaskModel source) => new()
+    {
+        Title = source.Title,
+        Priority = source.Priority,
+        Color = source.Color,
+        CategoryId = source.CategoryId,
+        Duration = source.Duration,
+        PlannedAt = source.PlannedAt,
+        Items = CloneItems(source.Items)
+        // StartedAt / CompletedAt deliberately not copied.
+    };
+
+    private static NoteModel CloneNote(NoteModel source) => new()
+    {
+        Title = source.Title,
+        Content = source.Content,
+        Priority = source.Priority,
+        Color = source.Color,
+        CategoryId = source.CategoryId
+    };
+
+    private static HabitModel CloneHabit(HabitModel source) => new()
+    {
+        Title = source.Title,
+        Priority = source.Priority,
+        Color = source.Color,
+        CategoryId = source.CategoryId,
+        RepeatCount = source.RepeatCount,
+        RepeatInterval = source.RepeatInterval,
+        RepeatPeriod = source.RepeatPeriod,
+        DisplayMetric = source.DisplayMetric,
+        TargetQuantity = source.TargetQuantity,
+        Duration = source.Duration,
+        StartAt = source.StartAt,
+        Items = CloneItems(source.Items)
+        // TimesDone / LastTimeDoneAt are intentionally not copied.
+    };
+
+    private static List<ItemModel>? CloneItems(List<ItemModel>? source)
+        => source?.Select(item => new ItemModel { Title = item.Title }).ToList();
+}
diff --git a/OpenHabitTracker/Services/CopiedItemPersistence.cs b/OpenHabitTracker/Services/CopiedItemPersistence.cs
new file mode 100644
--- /dev/null
+++ b/OpenHabitTracker/Services/CopiedItemPersistence.cs
@@ -0,0 +1,40 @@
+using OpenHabitTracker.App;
+using OpenHabitTracker.Data;
+using OpenHabitTracker.Data.Entities;
+using OpenHabitTracker.Data.Models;
+
+namespace OpenHabitTracker.Services;
+
+/// <summary>
+/// Saves the detached checklist of a newly created task/recurring task only.
+/// Existing items are never updated or deleted by duplication.
+/// </summary>
+internal static class CopiedItemPersistence
+{
+    public static async Task SaveNewItems(ClientState clientState, ItemsModel parent)
+    {
+        if (parent.Items is not { Count: > 0 })
+            return;
+
+        // Create the whole checklist first. New IDs and owner bookkeeping are
+        // established only after the database assigned each one.
+        foreach (ItemModel item in parent.Items)
+        {
+            ItemEntity copy = new()
+            {
+                ParentId = parent.Id,
+                Title = item.Title,
+                DoneAt = null
+            };
+
+            await clientState.DataAccess.AddItem(copy);
+
+            item.Id = copy.Id;
+            item.ParentId = parent.Id;
+            item.DoneAt = null;
+
+            clientState.Items ??= new();
+            clientState.Items[item.Id] = item;
+        }
+    }
+}
