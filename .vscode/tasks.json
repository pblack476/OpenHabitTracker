{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build: WASM",
			"type": "process",
			"command": "dotnet",
			"args": ["build", "${workspaceFolder}/OpenHabitTracker.Blazor.Wasm/OpenHabitTracker.Blazor.Wasm.csproj", "--configuration", "Debug"],
			"options": { "cwd": "${workspaceFolder}" },
			"problemMatcher": "$msCompile",
			"group": { "kind": "build", "isDefault": true }
		},
		{
			"label": "build: Server",
			"type": "process",
			"command": "dotnet",
			"args": ["build", "${workspaceFolder}/OpenHabitTracker.Blazor.Web/OpenHabitTracker.Blazor.Web.csproj", "--configuration", "Debug"],
			"options": { "cwd": "${workspaceFolder}" },
			"problemMatcher": "$msCompile",
			"group": "build"
		},
		{
			"label": "build: Photino",
			"type": "process",
			"command": "dotnet",
			"args": ["build", "${workspaceFolder}/OpenHabitTracker.Blazor.Photino/OpenHabitTracker.Blazor.Photino.csproj", "--configuration", "Debug"],
			"options": { "cwd": "${workspaceFolder}" },
			"problemMatcher": "$msCompile",
			"group": "build"
		},
		{
			"label": "test: UnitTests",
			"type": "process",
			"command": "dotnet",
			"args": ["test", "${workspaceFolder}/OpenHabitTracker.UnitTests/OpenHabitTracker.UnitTests.csproj", "--configuration", "Debug"],
			"options": { "cwd": "${workspaceFolder}" },
			"problemMatcher": "$msCompile",
			"group": { "kind": "test", "isDefault": true }
		},
		{
			"label": "run: WASM (HTTP)",
			"type": "process",
			"command": "dotnet",
			"args": ["run", "--project", "${workspaceFolder}/OpenHabitTracker.Blazor.Wasm/OpenHabitTracker.Blazor.Wasm.csproj", "--launch-profile", "http"],
			"options": { "cwd": "${workspaceFolder}" },
			"problemMatcher": "$msCompile"
		},
		{
			"type": "maui",
			"targetFramework": "net10.0-windows10.0.19041.0",
			"configuration": "Debug",
			"project": "${workspaceFolder}/OpenHabitTracker.Blazor.Maui/OpenHabitTracker.Blazor.Maui.csproj",
			"problemMatcher": [
				"$msCompile",
				"$maui-problem-matcher-location",
				"$maui-problem-matcher",
				"$maui-problem-matcher-location-multiline",
				"$maui-problem-matcher-multiline"
			],
			"label": "maui: Build Windows"
		}
	]
}
